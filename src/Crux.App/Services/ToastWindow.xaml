<Window x:Class="Crux.App.Services.ToastWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Crux.App.Localization"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <Border Width="360" Margin="12" Padding="14,12" CornerRadius="14"
            Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Path DockPanel.Dock="Left" Width="28" Height="28" Margin="2" VerticalAlignment="Top" Data="{StaticResource LogoGeometry}" Fill="{DynamicResource LogoBrush}" Stretch="Uniform" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Icon.X}" Width="28" Height="28"
                    VerticalAlignment="Top" Click="OnClose" AutomationProperties.Name="{l:T Close}" />
            <StackPanel Margin="12,0,8,0">
                <TextBlock Text="{DynamicResource AppDisplayName}" FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
