<UserControl x:Class="Crux.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Crux.App.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageColumn}">
            <TextBlock Text="{l:T NavAbout}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:T AboutSubtitle}" Style="{StaticResource PageSubtitle}" />
            <Border Style="{StaticResource Card}" Padding="24,20">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Width="72" Height="72" Data="{StaticResource LogoGeometry}" Fill="{DynamicResource LogoBrush}" Stretch="Uniform" />
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource AppDisplayName}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,6" />
                        <TextBlock Text="{l:T AboutDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{l:T SectionSafety}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T SafetyNoAccess}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T SafetyNoHooks}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{l:T SafetyRules}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{l:T SectionTips}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T FortniteHintTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:T FortniteHintText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
