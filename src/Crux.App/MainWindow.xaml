<Window x:Class="Crux.App.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Crux.App.Controls"
        xmlns:views="clr-namespace:Crux.App.Views"
        xmlns:l="clr-namespace:Crux.App.Localization"
        Title="Crux"
        Width="1240"
        Height="820"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SidebarBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Path Width="22" Height="22" Data="{StaticResource LogoGeometry}" Fill="{DynamicResource LogoBrush}" Stretch="Uniform" />
                <TextBlock Text="{DynamicResource ProductName}" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
                <Border Style="{StaticResource WarningBadge}" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{DynamicResource DevBadgeVisibility}">
                    <TextBlock Text="DEV" />
                </Border>
            </StackPanel>

            <ContentControl Grid.Column="1" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                            FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Tag" Value="{StaticResource Icon.Crosshair}" />
                        <Setter Property="Content" Value="{l:T NavCrosshair}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Presets">
                                <Setter Property="Tag" Value="{StaticResource Icon.Bookmark}" />
                                <Setter Property="Content" Value="{l:T NavPresets}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Overlay">
                                <Setter Property="Tag" Value="{StaticResource Icon.Monitor}" />
                                <Setter Property="Content" Value="{l:T NavOverlay}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Hotkeys">
                                <Setter Property="Tag" Value="{StaticResource Icon.Keyboard}" />
                                <Setter Property="Content" Value="{l:T NavHotkeys}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="System">
                                <Setter Property="Tag" Value="{StaticResource Icon.Settings}" />
                                <Setter Property="Content" Value="{l:T NavSystem}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="About">
                                <Setter Property="Tag" Value="{StaticResource Icon.Info}" />
                                <Setter Property="Content" Value="{l:T NavAbout}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconElement Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="{StaticResource Icon.Minus}" Click="OnMinimize"
                        AutomationProperties.Name="{l:T WindowMinimize}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="{StaticResource Icon.Square}"
                        Click="OnMaximize" AutomationProperties.Name="{l:T WindowMaximize}" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="{StaticResource Icon.X}" Click="OnClose"
                        AutomationProperties.Name="{l:T Close}" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="10,6,10,12">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Margin="0"
                                  IsChecked="{Binding OverlayVisible}" AutomationProperties.Name="{l:T SidebarOverlay}" />
                        <TextBlock Text="{l:T SidebarOverlay}" FontWeight="Medium" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{l:T SidebarPreset}" />
                        <Run Text="{Binding SelectedPreset.Name, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="{l:T SidebarHotkey}" />
                        <Run Text="{Binding ToggleHotkeyText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                    </TextBlock>
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Badge}" Margin="0,0,4,0"
                                Visibility="{Binding ShowOnlyOverGame, Converter={StaticResource Visible}}">
                            <TextBlock Text="{l:T BadgeGameOnly}" />
                        </Border>
                        <Border Style="{StaticResource Badge}"
                                Visibility="{Binding StreamerMode, Converter={StaticResource Visible}}">
                            <TextBlock Text="{l:T BadgeStreamer}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel>
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Crosshair}" Content="{l:T NavCrosshair}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Crosshair}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Bookmark}" Content="{l:T NavPresets}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Presets}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Monitor}" Content="{l:T NavOverlay}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Overlay}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Keyboard}" Content="{l:T NavHotkeys}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=Hotkeys}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Settings}" Content="{l:T NavSystem}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource NavButton}" Tag="{StaticResource Icon.Info}" Content="{l:T NavAbout}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumMatch}, ConverterParameter=About}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1,1,0,0" CornerRadius="18,0,0,0">
            <Grid Margin="28,24,28,0" MaxWidth="1200">
                <views:CrosshairPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Crosshair}" />
                <views:PresetsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Presets}" />
                <views:OverlayPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Overlay}" />
                <views:HotkeysPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Hotkeys}" />
                <views:SystemPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=System}" />
                <views:AboutPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=About}" />
            </Grid>
        </Border>

        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource DialogScrimBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="460" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PopupBrush}" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DialogCancel" Content="{l:T Cancel}" MinWidth="100" Margin="0,0,8,0" Click="OnDialogCancel" />
                        <Button x:Name="DialogConfirm" MinWidth="100" Click="OnDialogConfirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
