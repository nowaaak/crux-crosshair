<UserControl x:Class="Crux.App.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Crux.App.Localization">
    <StackPanel Width="260">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{StaticResource Icon.X}" Margin="6,0,0,0"
                    Height="32" Width="32" Click="OnClear" ToolTip="{l:T HotkeyClear}"
                    AutomationProperties.Name="{l:T HotkeyClear}" />
            <TextBox x:Name="KeyBox"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Cursor="Hand"
                     TextAlignment="Center"
                     ToolTip="{l:T HotkeyCaptureHint}"
                     PreviewKeyDown="OnPreviewKeyDown"
                     GotKeyboardFocus="OnGotFocus"
                     LostKeyboardFocus="OnLostFocus" />
        </DockPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource WarningText}" FontSize="12" TextWrapping="Wrap"
                   Margin="0,4,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
